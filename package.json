{
  "name": "shell-to-chrome",
  "version": "0.1.0",
  "private": true,
  "description": "A local-only Chrome terminal and Claude Code debugging cockpit.",
  "type": "module",
  "scripts": {
    "start": "node bridge/server.js",
    "dev": "node --watch bridge/server.js",
