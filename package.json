    "postinstall": "node scripts/fix-node-pty-permissions.js",
    "prepare:extension": "node scripts/copy-vendor.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  }
}
