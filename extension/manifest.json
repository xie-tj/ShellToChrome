{
  "manifest_version": 3,
  "name": "Shell to Chrome",
  "version": "0.1.0",
  "description": "在 Chrome 中查看本机终端并让 Claude Code 协助调试。",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "ws://127.0.0.1/*"],
  "action": {
    "default_title": "打开 Shell to Chrome"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
